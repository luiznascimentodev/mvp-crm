# Ambiente
NODE_ENV=development
PORT=3333

# Banco de dados (Postgres via Docker)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/orbit_crm?schema=public"

# JWT — mínimo 32 caracteres (troque em produção!)
JWT_SECRET="orbit-crm-super-secret-key-dev-32chars!!"
JWT_EXPIRES_IN="1h"

# Storage — MinIO via Docker (troque para S3 em produção)
STORAGE_ENDPOINT="http://localhost:9000"
STORAGE_REGION="us-east-1"
STORAGE_ACCESS_KEY="minioadmin"
STORAGE_SECRET_KEY="minioadmin"
STORAGE_BUCKET="orbit-crm"

# Redis via Docker
REDIS_HOST="localhost"
REDIS_PORT=6379
# REDIS_PASSWORD=

# SMTP (Ethereal — fake email para dev)
SMTP_HOST="smtp.ethereal.email"
SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
SMTP_FROM="noreply@orbit-crm.app"

# Frontend (usado para links em e-mails de convite)
FRONTEND_URL="http://localhost:5173"
